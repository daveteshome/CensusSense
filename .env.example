# Groq (OpenAI-compatible API, free developer tier, no card required)
GROQ_API_KEY=

# Snowflake (use the least-privilege role from sql/setup_role.sql, not ACCOUNTADMIN)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=CENSUSSENSE_APP_ROLE
SNOWFLAKE_WAREHOUSE=CENSUSSENSE_WH
SNOWFLAKE_DATABASE=US_OPEN_CENSUS_DATA__NEIGHBORHOOD_INSIGHTS__FREE_DATASET
SNOWFLAKE_SCHEMA=PUBLIC

# Demo sign-in accounts (documented in README for evaluators) --
# comma-separated user:pass pairs, one per account, each with its own
# persisted conversation history (see CONVERSATIONS_DB_PATH below).
DEMO_ACCOUNTS=alice:pass1,bob:pass2,carol:pass3

# Optional: set to 1 locally to run tests that hit the real Snowflake account
RUN_LIVE_SNOWFLAKE_TESTS=0

# Optional: where per-account conversation history is persisted (SQLite
# file, created on first run if missing). On Railway this needs a
# Volume mounted at this path to survive a redeploy -- see README.
CONVERSATIONS_DB_PATH=data/conversations.db
